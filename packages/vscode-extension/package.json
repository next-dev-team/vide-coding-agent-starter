{
  "name": "agent-kanban-vscode",
  "displayName": "Agent Kanban",
  "description": "Trello-like Kanban board for markdown-based task management — works with AI agents via MCP",
  "version": "0.1.34",
  "publisher": "agent-kanban",
  "repository": {
    "type": "git",
    "url": "https://github.com/next-dev-team/vide-coding-agent-starter"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:docs/tasks/*.md",
    "onView:agentKanban.boardView",
    "onCommand:agentKanban.openBoard"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentKanban.openBoard",
        "title": "Open Kanban Board",
        "category": "Agent Kanban"
      },
      {
        "command": "agentKanban.refreshBoard",
        "title": "Refresh Board",
        "category": "Agent Kanban"
      },
      {
        "command": "agentKanban.createTask",
        "title": "New Task",
        "category": "Agent Kanban"
      },
      {
        "command": "agentKanban.createPrd",
        "title": "New PRD",
        "category": "Agent Kanban"
      },
      {
        "command": "agentKanban.setupMcpServer",
        "title": "Setup MCP Server (GitHub Copilot)",
        "category": "Agent Kanban"
      },
      {
        "command": "agentKanban.selectProject",
        "title": "Select Project",
        "category": "Agent Kanban"
      },
      {
        "command": "agentKanban.openWebview",
        "title": "Open Document Webview",
        "category": "Agent Kanban"
      },
      {
        "command": "agentKanban.openWideBoard",
        "title": "Open Wide Board (Trello-style)",
        "category": "Agent Kanban"
      },
      {
        "command": "agentKanban.openDocsPanel",
        "title": "Open Docs Panel",
        "category": "Agent Kanban"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-kanban",
          "title": "Agent Kanban",
          "icon": "$(checklist)"
        }
      ]
    },
    "views": {
      "agent-kanban": [
        {
          "type": "webview",
          "id": "agentKanban.boardView",
          "name": "Board"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npx vite build -c webview-ui/vite.config.mts && node build.mjs",
    "dev": "node build.mjs --watch",
    "clean": "rimraf dist *.tsbuildinfo webview-ui/dist",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies",
    "version:bump": "npm version patch --no-git-tag-version",
    "package:root": "vsce package --no-dependencies --out ../../",
    "test": "echo 'no tests yet'",
    "lint": "echo 'no lint yet'"
  },
  "dependencies": {
    "@agent-kanban/core": "workspace:*",
    "bits-ui": "^1.3.0",
    "clsx": "^2.1.1",
    "lucide-svelte": "^0.471.0",
    "svelte-dnd-action": "^0.9.61",
    "tailwind-merge": "^2.6.0",
    "tailwind-variants": "^1.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.27.0",
    "rimraf": "^6.0.0",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.7"
  }
}
