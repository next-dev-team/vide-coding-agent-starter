{
  "name": "@agent-kanban/mcp-server",
  "version": "0.1.0",
  "description": "MCP server for managing markdown-based Kanban workflows",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "kanban-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @agent-kanban/core run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo 'no lint yet'"
  },
  "dependencies": {
    "@agent-kanban/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^12.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
